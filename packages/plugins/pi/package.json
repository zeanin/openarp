{
  "name": "@formai/plugin-pi",
  "version": "0.1.0",
  "description": "Pi agent integration plugin for Formai — replaces Codex with earendil-works/pi native multi-tenant agent runtime",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --shims --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --shims --watch",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@formai/shared": "workspace:*",
    "@formai/plugin": "workspace:*",
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-agent-core": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "koa": "^2.15.0",
    "@types/koa": "^2.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
